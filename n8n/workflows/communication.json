      "position": [
        0,
        0
      ],
      "webhookId": "ai-lead-communication",
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-lead-communication",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": 202
            }
          },
          "noResponseBody": true
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "aiLeadWebhookAuth",
          "name": "AI Lead Dispatch Webhook"
        }
      }
    },
    {
