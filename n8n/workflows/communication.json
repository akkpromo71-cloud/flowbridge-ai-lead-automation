        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { generation: $(\"Dispatch\").item.json.body.generation } }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "aiLeadInternalAuth",
          "name": "AI Lead Internal API"
        }
      },
      "retryOnFail": false
