# Stable frozen fixture bytes and portable shell scripts across Windows/Linux.
* text=auto eol=lf
*.png binary
*.webp binary
*.woff2 binary
# Preserve approved fixture/config bytes, including their existing line endings.
/evaluation/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/config/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
